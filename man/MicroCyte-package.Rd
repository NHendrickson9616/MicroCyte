\name{MicroCyte-package}
\alias{MicroCyte-package}
\alias{MicroCyte}
\title{MicroCyte: Guided Microcytometry Processing and Analysis}
\description{
MicroCyte provides explicit, reusable functions for microscopy image
processing and microcytometry analysis. Analysis functions accept their data
and paths as arguments and return data, plots, or structured result objects.
}
